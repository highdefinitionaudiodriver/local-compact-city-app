# Local Compact City App environment template

# Database
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Export signing
# Required for CSV/PDF HMAC signatures. Use at least 32 random characters in production.
EXPORT_HMAC_SECRET="replace-with-strong-random-hmac-secret"

# JPKI bridge
JPKI_MODE="mock"
JPKI_WEB_ENDPOINT="http://127.0.0.1:8000"

# Optional xID / OIDC production bridge
XID_ISSUER=""
XID_CLIENT_ID=""
XID_CLIENT_SECRET=""
